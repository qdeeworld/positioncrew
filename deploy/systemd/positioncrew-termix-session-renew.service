[Unit]
Description=Renew PositionCrew TermiX wallet session
After=network-online.target
Wants=network-online.target
AssertFileNotEmpty=/opt/positioncrew-termix-session-renew/renew-termix-session-token.mjs
OnFailure=crosswind-alert@positioncrew-termix-session-renew.service

[Service]
Type=oneshot
User=positioncrew-session-renew
Group=positioncrew-session-renew
WorkingDirectory=/opt/positioncrew-termix-session-renew
Environment=TERMIX_SESSION_OWNER_KEY_FILE=%d/owner-key
Environment=TERMIX_SESSION_TOKEN_PATH=/var/lib/positioncrew-termix-session-renew/termix-session.token
Environment=TERMIX_BASE_URL=https://platform-backend.prod.termix.live
ExecStart=/usr/bin/node /opt/positioncrew-termix-session-renew/renew-termix-session-token.mjs
TimeoutStartSec=2min
UMask=0077

StateDirectory=positioncrew-termix-session-renew
StateDirectoryMode=0700

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
PrivateMounts=true
ProtectHome=yes
ProtectSystem=strict
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
MemorySwapMax=0
TasksMax=16
LimitNOFILE=256

StandardOutput=journal
StandardError=journal
