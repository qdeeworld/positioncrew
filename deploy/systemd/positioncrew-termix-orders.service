[Unit]
Description=PositionCrew TermiX provider-order observer
After=network-online.target
Wants=network-online.target
ConditionFileNotEmpty=/etc/positioncrew-runtime/credentials/termix-session.token
ConditionFileNotEmpty=/opt/positioncrew-termix-orders/watch-termix-orders.mjs
OnFailure=crosswind-alert@positioncrew-termix-orders.service

[Service]
Type=oneshot
User=positioncrew-orders
Group=positioncrew-orders
WorkingDirectory=/opt/positioncrew-termix-orders
Environment=TERMIX_AGENT_ID=cmt4dzxvcli4tw70125nd5ra8
Environment=TERMIX_BASE_URL=https://platform-backend.prod.termix.live
Environment=TERMIX_SESSION_TOKEN_FILE=%d/session-token
Environment=TERMIX_ORDER_STATE_PATH=/var/lib/positioncrew-termix-orders/state.json
Environment=TERMIX_ORDER_OUTBOX_PATH=/var/spool/positioncrew-termix-order-outbox
LoadCredential=session-token:/etc/positioncrew-runtime/credentials/termix-session.token
ExecStart=/usr/bin/node /opt/positioncrew-termix-orders/watch-termix-orders.mjs
TimeoutStartSec=5h
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=yes
ProtectSystem=strict
StateDirectory=positioncrew-termix-orders
StateDirectoryMode=0700
ReadWritePaths=/var/spool/positioncrew-termix-order-outbox
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=96M
TasksMax=16
