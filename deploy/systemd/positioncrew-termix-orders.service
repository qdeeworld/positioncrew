[Unit]
Description=PositionCrew TermiX provider-order observer
After=network-online.target
Wants=network-online.target
ConditionFileNotEmpty=/etc/positioncrew-runtime/credentials/termix-session.token
ConditionFileNotEmpty=/home/crosswind/apps/positioncrew/dist/cli/watch-termix-orders.js
OnFailure=crosswind-alert@positioncrew-termix-orders.service

[Service]
Type=oneshot
User=positioncrew-orders
Group=positioncrew-orders
Environment=TERMIX_AGENT_ID=cmt4dzxvcli4tw70125nd5ra8
Environment=TERMIX_BASE_URL=https://platform-backend.prod.termix.live
Environment=TERMIX_SESSION_TOKEN_FILE=%d/session-token
Environment=TERMIX_ORDER_STATE_PATH=/var/lib/positioncrew-termix-orders/state.json
Environment=TERMIX_ORDER_OUTBOX_PATH=/var/lib/positioncrew-termix-orders/outbox
LoadCredential=session-token:/etc/positioncrew-runtime/credentials/termix-session.token
ExecStart=/usr/bin/node /home/crosswind/apps/positioncrew/dist/cli/watch-termix-orders.js
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
StateDirectory=positioncrew-termix-orders
StateDirectoryMode=0770
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=96M
TasksMax=16
