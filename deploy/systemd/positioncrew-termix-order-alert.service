[Unit]
Description=Alert for a newly actionable PositionCrew TermiX order
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/crosswind/crosswind.env
ConditionPathExists=/opt/crosswind/package.json
ConditionFileNotEmpty=/opt/positioncrew-termix-orders/notify-termix-orders.mjs
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=crosswind
Group=crosswind
SupplementaryGroups=positioncrew-orders
WorkingDirectory=/opt/crosswind
Environment=HOME=/home/crosswind
Environment=PATH=/home/crosswind/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/crosswind/crosswind.env
Environment=TERMIX_ORDER_OUTBOX_PATH=/var/spool/positioncrew-termix-order-outbox
ExecStart=/usr/bin/node /opt/positioncrew-termix-orders/notify-termix-orders.mjs
TimeoutStartSec=30s
Restart=on-failure
RestartSec=1min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ReadWritePaths=/var/spool/positioncrew-termix-order-outbox
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
