[Unit]
Description=Alert for a newly actionable PositionCrew TermiX order
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/crosswind/crosswind.env
ConditionPathExists=/opt/crosswind/package.json

[Service]
Type=oneshot
User=crosswind
Group=crosswind
WorkingDirectory=/opt/crosswind
Environment=HOME=/home/crosswind
Environment=PATH=/home/crosswind/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/crosswind/crosswind.env
ExecStart=/usr/bin/npm run alert:telegram -- POSITIONCREW_ORDER "A funded TermiX order needs operator action; inspect /var/lib/positioncrew-termix-orders/pending.json and its delivery deadline. No transaction was performed automatically."
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

