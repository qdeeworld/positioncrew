[Unit]
Description=Alert for a newly actionable PositionCrew TermiX order
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/crosswind/crosswind.env
ConditionPathExists=/opt/crosswind/package.json
ConditionPathExists=/home/crosswind/apps/positioncrew/dist/cli/notify-termix-orders.js
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=crosswind
Group=crosswind
WorkingDirectory=/opt/crosswind
Environment=HOME=/home/crosswind
Environment=PATH=/home/crosswind/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/crosswind/crosswind.env
Environment=TERMIX_ORDER_OUTBOX_PATH=/var/lib/positioncrew-termix-orders/outbox
ExecStart=/usr/bin/node /home/crosswind/apps/positioncrew/dist/cli/notify-termix-orders.js
TimeoutStartSec=30s
Restart=on-failure
RestartSec=1min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ReadWritePaths=/var/lib/positioncrew-termix-orders
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
