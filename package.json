{
  "name": "positioncrew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Job-first BSC capital operations with reproducible agent advantage evidence",
  "scripts": {
    "build": "npm run build:core && npm run build:web && npm run build:sites && npm run build:termix-renewer && npm run build:termix-orders && npm run build:termix-session-renewer",
    "build:core": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:sites": "node scripts/build-sites.mjs",
    "db:generate:custom": "drizzle-kit generate --config=drizzle.config.ts --custom",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config dist/server/wrangler.local.json",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev --local --config dist/server/wrangler.local.json --port 4175",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "preview": "npm run db:migrate:local && wrangler dev --local --config dist/server/wrangler.local.json --port 4175",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:integration:d1": "npm run build && npm run test:integration:d1:built",
    "test:integration:d1:built": "node test/integration/d1-current-hire.mjs && node test/integration/d1-altana-activation.mjs && node test/integration/d1-shadow-grid-ledger.mjs",
    "test:e2e": "npm run build && node test/integration/run-playwright-with-d1.mjs",
    "benchmark:verify-lock": "tsx src/cli/verify-benchmark-lock.ts",
    "benchmark:verify-locks": "tsx src/cli/verify-benchmark-lock.ts",
    "benchmark:verify-captures": "tsx src/cli/verify-agent-capture-manifest.ts",
    "benchmark:verify-marketplace-protocol": "tsx src/cli/marketplace-provenance.ts verify-protocol",
    "benchmark:capture-marketplace": "tsx src/cli/marketplace-provenance.ts capture",
    "benchmark:verify-marketplace": "tsx src/cli/marketplace-provenance.ts verify",
    "benchmark:verify-report": "tsx src/cli/verify-agent-advantage-report.ts",
    "benchmark:publish-report": "tsx src/cli/publish-agent-advantage-report.ts",
    "benchmark:founder-report": "tsx src/cli/build-founder-agent-advantage-report.ts",
    "benchmark:verify-founder-report": "tsx src/cli/verify-founder-agent-advantage-report.ts",
    "benchmark:publish-founder-report": "tsx src/cli/publish-founder-agent-advantage-report.ts",
    "benchmark:session": "tsx src/cli/benchmark-session.ts",
    "capture:listing-media": "node scripts/capture-listing-media.mjs",
    "runtime:termix": "tsx src/cli/run-termix-runtime.ts",
    "watch:termix-orders": "tsx src/cli/watch-termix-orders.ts",
    "prepare:termix-lending-delivery": "tsx src/cli/prepare-termix-lending-delivery.ts",
    "notify:termix-orders": "tsx src/cli/notify-termix-orders.ts",
    "preflight:termix": "tsx src/cli/termix-onboarding-preflight.ts",
    "evidence:venus-testnet-supply": "tsx src/cli/venus-testnet-native-supply.ts",
    "activate:grant-altana-venus-session": "tsx src/cli/grant-altana-venus-session.ts",
    "verify:gate2a": "tsx src/cli/run-lending-rescue.ts",
    "verify:all": "tsx src/cli/verify-all-providers.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "shadow-grid:collect": "node scripts/collect-bounded-grid-shadow-ledger.mjs",
    "spike:external-provider": "tsx src/cli/spike-external-provider-adapter.ts",
    "spike:heyanon-venus": "tsx src/cli/spike-heyanon-venus.ts",
    "spike:heyanon-beefy": "tsx src/cli/spike-heyanon-beefy.ts",
    "spike:heyanon-v3-position": "tsx src/cli/spike-heyanon-v3-position.ts",
    "spike:heyanon-v3-lp-job": "tsx src/cli/spike-heyanon-v3-lp-job.ts",
    "spike:bnb-lp-signed-quote": "tsx src/cli/spike-bnb-lp-range-a2a.ts",
    "activate:bnb-lp-funded-delivery": "tsx src/cli/activate-bnb-lp-range-provider.ts",
    "spike:validate-external-provider": "tsx src/cli/validate-external-provider-delivery.ts",
    "activate:external-provider": "tsx src/cli/activate-external-provider.ts",
    "provider:export-kit": "tsx src/cli/provider-conformance.ts export",
    "provider:check": "tsx src/cli/provider-conformance.ts check",
    "provider:verify-result": "tsx src/cli/provider-conformance.ts verify-result",
    "provider:verify-bundle": "tsx src/cli/provider-conformance.ts verify-bundle",
    "build:termix-renewer": "esbuild src/cli/renew-termix-runtime-token.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/runtime/renew-termix-runtime-token.mjs",
    "build:termix-orders": "esbuild src/cli/watch-termix-orders.ts src/cli/notify-termix-orders.ts src/cli/prepare-termix-lending-delivery.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist/runtime --out-extension:.js=.mjs",
    "build:termix-session-renewer": "esbuild src/cli/renew-termix-session-token.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/termix-session-renew/renew-termix-session-token.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@altananetwork/sdk": "0.7.1",
    "@bnbagent/sdk": "0.5.5",
    "@noble/hashes": "^1.8.0",
    "drizzle-orm": "0.45.2",
    "ethers": "6.17.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.122.0"
  }
}
