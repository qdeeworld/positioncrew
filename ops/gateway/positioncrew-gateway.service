[Unit]
Description=PositionCrew bounded access gateway (loopback staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/positioncrew-gateway
ExecStart=/usr/bin/node /opt/positioncrew-gateway/gateway.mjs
LoadCredential=gateway-key:/etc/positioncrew-gateway/key
Environment=GATEWAY_KEY_FILE=%d/gateway-key
Environment=GATEWAY_HOST=127.0.0.1
Environment=GATEWAY_PORT=18741
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=25%
TasksMax=32
LimitNOFILE=512
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
