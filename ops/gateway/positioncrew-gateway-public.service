[Unit]
Description=PositionCrew bounded HTTPS access gateway
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/positioncrew-gateway/fullchain.pem

[Service]
Type=simple
User=pc-gateway
Group=pc-gateway
WorkingDirectory=/opt/positioncrew-gateway
ExecStart=/usr/bin/node /opt/positioncrew-gateway/gateway.mjs
Environment=GATEWAY_KEY_FILE=/etc/positioncrew-gateway/key
Environment=GATEWAY_TLS_KEY_FILE=/etc/positioncrew-gateway/privkey.pem
Environment=GATEWAY_TLS_CERT_FILE=/etc/positioncrew-gateway/fullchain.pem
Environment=GATEWAY_HOST=0.0.0.0
Environment=GATEWAY_PORT=443
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=25%
TasksMax=32
LimitNOFILE=512
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
