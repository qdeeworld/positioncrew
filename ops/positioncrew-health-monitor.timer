[Unit]
Description=Check PositionCrew every five minutes through November 5, 2026 UTC

[Timer]
OnCalendar=2026-09-06..30 *:00/5:00 UTC
OnCalendar=2026-10-* *:00/5:00 UTC
OnCalendar=2026-11-01..05 *:00/5:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=positioncrew-health-monitor.service

[Install]
WantedBy=timers.target

